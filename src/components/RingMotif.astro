---
/** Einstein-ring line art from the printed flyer: faint concentric rings, two bright arcs, a lensed source. */
---

<svg class="ring" viewBox="0 0 816 245" preserveAspectRatio="xMaxYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <g transform="translate(690 140)" fill="none" stroke="currentColor" stroke-width="0.9">
    <circle r="118" opacity="0.08"></circle>
    <circle r="92" opacity="0.11"></circle>
    <circle r="66" opacity="0.14" stroke-dasharray="2 5"></circle>
    <circle r="40" opacity="0.18"></circle>
    <path d="M -95 -28 A 99 99 0 0 1 60 -78" opacity="0.32" stroke-width="1.6" stroke-linecap="round"></path>
    <path d="M 92 36 A 99 99 0 0 1 -40 92" opacity="0.32" stroke-width="1.6" stroke-linecap="round"></path>
    <circle r="3.2" fill="currentColor" stroke="none" opacity="0.55"></circle>
  </g>
  <g fill="currentColor">
    <circle cx="62" cy="28" r="0.9" opacity="0.5"></circle>
    <circle cx="140" cy="212" r="0.7" opacity="0.4"></circle>
    <circle cx="233" cy="30" r="1.1" opacity="0.45"></circle>
    <circle cx="318" cy="196" r="0.8" opacity="0.4"></circle>
    <circle cx="402" cy="26" r="0.7" opacity="0.4"></circle>
    <circle cx="470" cy="214" r="1.0" opacity="0.5"></circle>
    <circle cx="520" cy="60" r="0.8" opacity="0.4"></circle>
    <circle cx="560" cy="18" r="1.2" opacity="0.55"></circle>
    <circle cx="600" cy="230" r="0.8" opacity="0.4"></circle>
    <circle cx="735" cy="24" r="0.9" opacity="0.5"></circle>
    <circle cx="790" cy="90" r="0.7" opacity="0.45"></circle>
    <circle cx="770" cy="222" r="1.0" opacity="0.5"></circle>
    <circle cx="505" cy="140" r="0.7" opacity="0.4"></circle>
    <circle cx="372" cy="118" r="0.6" opacity="0.35"></circle>
  </g>
</svg>

<style>
  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #fff;
    pointer-events: none;
  }
</style>
