---
import Layout from "../layouts/Layout.astro";
import {
  Content as Abstract,
  frontmatter,
} from "../../content/current-speaker.md";
import {
  loadContent,
  display,
  formatDate,
  formatTime,
} from "../lib/content.mjs";
import { localUrl } from "../lib/site";
const { current, headshot, semester, sample } = loadContent(frontmatter);
---

<Layout title="Upcoming talk" active="home" sample={sample}>
  <div class="page-intro">
    <p class="eyebrow">{semester}</p>
    <h1>Upcoming talk</h1>
    <p class="intro-copy">A place to share ideas about our universe.</p>
  </div>
  {current ? (
    <article aria-labelledby="talk-title">
      <div class="talk-overview">
        <figure class="portrait">
          <img
            src={localUrl(headshot)}
            alt={
              headshot.endsWith("portrait-placeholder.svg")
                ? "Placeholder portrait; speaker headshot forthcoming"
                : `Portrait of ${display(current.speaker)}`
            }
            width="480"
            height="560"
          />
        </figure>
        <div class="talk-details">
          <p class="speaker">{display(current.speaker)}</p>
          {current.affiliation && (
            <p class="affiliation">{current.affiliation}</p>
          )}
          <h2 id="talk-title" class="talk-title">
            {display(current.title)}
          </h2>
          <dl class="logistics">
            <div>
              <dt>Date</dt>
              <dd>
                {current.date ? (
                  <time datetime={current.date}>
                    {formatDate(current.date)}
                  </time>
                ) : (
                  display(current.date)
                )}
              </dd>
            </div>
            <div>
              <dt>Time</dt>
              <dd>
                {formatTime(current.time)}
                {current.time && <span class="timezone">Eastern Time</span>}
              </dd>
            </div>
            <div>
              <dt>Location</dt>
              <dd>{display(current.location)}</dd>
            </div>
          </dl>
        </div>
      </div>
      <section class="abstract prose" aria-labelledby="abstract-heading">
        <h2 id="abstract-heading">Abstract</h2>
        <Abstract />
      </section>
    </article>
  ) : (
    <section class="empty-state">
      <h2>Next talk to be announced.</h2>
      <p>Please check back for the next speaker and talk details.</p>
    </section>
  )}
  <div class="page-bottom">
    <a class="text-link" href={localUrl("schedule/")}>
      View the semester schedule <span aria-hidden="true">→</span>
    </a>
  </div>
</Layout>
