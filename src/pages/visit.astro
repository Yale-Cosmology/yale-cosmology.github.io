---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ParkingMap from '../components/ParkingMap.astro';
import { site } from '../site.config';

const page = await getEntry('pages', 'visit');
if (!page) throw new Error('Missing src/content/pages/visit.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <p class="label">Visit</p>
  <h1>{page.data.title}</h1>

  <ParkingMap />

  <div class="prose">
    <Content />
  </div>

  <hr class="rule" />
  <section class="contact">
    <p class="label label--blue">Questions</p>
    <ul>
      {site.hosts.map((h) => (
        <li>
          {h.name} · <a href={`mailto:${h.email}`}>{h.email}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0.3rem 0 1.6rem;
  }
  .contact ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
